<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Flick.Shared\Flick.Shared.csproj" />
    <ProjectReference Include="..\Flick.Upload\Flick.Upload.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- skips (locally) or fails (FLICK_INTEROP_REQUIRED=1) a test that needs flick_interop -->
    <Compile Include="..\Flick.Interop\Testing\InteropTestGate.cs" Link="InteropTestGate.cs" />
  </ItemGroup>
</Project>
