<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Flick.VideoRender</AssemblyName>
    <RootNamespace>Flick.VideoRender</RootNamespace>
    <!-- The tool speaks a fixed ASCII line protocol on stdout and parses invariant JSON; no
         culture data is involved. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA2007</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- IpcChild: the child side of the job protocol -->
    <ProjectReference Include="..\Flick.Ipc\Flick.Ipc.csproj" />
    <ProjectReference Include="..\Flick.VideoSDK\Flick.VideoSDK.csproj" />
  </ItemGroup>
</Project>
