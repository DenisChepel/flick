<Project Sdk="Microsoft.NET.Sdk">
  <!-- The C# side of crates/flick_interop, the one native library Flick loads in-process: the
       generated bindings (Generated/*.g.cs, `cargo codegen`), the loader and the public wrappers.
       Every [DllImport] in the solution lives here and is generated. Deliberately no
       PackageReference and no ProjectReference: Flick.Shared, Flick.Ipc, Flick.VideoSDK and
       Flick.Ui all reference this leaf, so anything added here is added to all of them. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Flick.Interop</RootNamespace>
    <!-- The generated bindings are raw pointers and function pointers throughout. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- CA2255: [ModuleInitializer] in library code is the advanced scenario it allows here: the
         DllImport resolver must be in place before the first P/Invoke in any host, and installing
         it does no I/O. -->
    <NoWarn>$(NoWarn);CA2007;CA2255</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Flick.Interop.Tests" />
    <InternalsVisibleTo Include="Flick.VideoSDK.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- InteropTestGate is source-linked into every test project that touches natives (it needs
         xunit, which this project must not reference). -->
    <Compile Remove="Testing\**" />
    <None Include="Testing\**" />
  </ItemGroup>
  <!-- Debug only: the same dev walk-up the loader does, so a missing library is a build warning
       with the command that fixes it instead of a dialog at first launch. -->
  <Target Name="WarnWhenInteropLibraryMissing" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <PropertyGroup>
      <_FlickCargoRoot>$([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildProjectDirectory)', 'Cargo.toml'))</_FlickCargoRoot>
      <_FlickInteropLib Condition="$([MSBuild]::IsOSPlatform('Windows'))">flick_interop.dll</_FlickInteropLib>
      <_FlickInteropLib Condition="$([MSBuild]::IsOSPlatform('OSX'))">libflick_interop.dylib</_FlickInteropLib>
      <_FlickInteropLib Condition="'$(_FlickInteropLib)' == ''">libflick_interop.so</_FlickInteropLib>
      <_FlickInteropFound>false</_FlickInteropFound>
      <_FlickInteropFound Condition="'$(FLICK_INTEROP_PATH)' != ''">true</_FlickInteropFound>
      <_FlickInteropFound Condition="'$(_FlickCargoRoot)' != '' And (Exists('$(_FlickCargoRoot)/target/debug/$(_FlickInteropLib)') Or Exists('$(_FlickCargoRoot)/target/release/$(_FlickInteropLib)') Or Exists('$(_FlickCargoRoot)/target/debug/deps/$(_FlickInteropLib)') Or Exists('$(_FlickCargoRoot)/target/release/deps/$(_FlickInteropLib)'))">true</_FlickInteropFound>
    </PropertyGroup>
    <Warning Condition="'$(_FlickInteropFound)' != 'true'"
             Text="$(_FlickInteropLib) was not found under target/debug or target/release: Flick.Ui, Flick.VideoRender and the interop tests need it. Build it with: cargo build -p flick_interop" />
  </Target>
</Project>
