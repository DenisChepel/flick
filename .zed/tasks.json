[
  {
    "label": "Build Flick.Ui (Debug)",
    "command": "dotnet",
    "args": [
      "build",
      "${ZED_WORKTREE_ROOT}/ui/Flick.Ui/Flick.Ui.csproj",
      "-p:Configuration=Debug",
    ],
  },
  {
    "label": "Build flick_capture (Debug)",
    "command": "cargo",
    "args": ["build", "-p", "flick_capture"],
  },
  {
    "label": "Rebuild All",
    "command": "dotnet",
    "args": [
      "build",
      "${ZED_WORKTREE_ROOT}/ui/Flick.Ui/Flick.Ui.csproj",
      "-p:Configuration=Debug",
      ";",
      "cargo",
      "build",
      "-p",
      "flick_capture",
    ],
  },
]
